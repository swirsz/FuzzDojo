#!/bin/bash
. /usr/local/sbin/e
if [ "$?" -gt 0 ]; then
    exit 1
fi
export LABEL=$1
export PROJECT_NAME=libsodium
export SANITIZER=$1
if [ -z "$SANITIZER" ]; then
    export SANITIZER='none'
    export LABEL='none'$LABEL
fi

if [ ! -d "/src-orig" ]; then
#----------------------------------------------------------------------
    rm -rf $SRC/$PROJECT_NAME
    #apt-get update && apt-get install -y make
    #git clone --depth 1 https://github.com/jedisct1/libsodium.git --branch stable libsodium
    cp -r /downloads/libsodium $SRC

    cp /opt/oss-fuzz/projects/$PROJECT_NAME/*.h $SRC/
    cp /opt/oss-fuzz/projects/$PROJECT_NAME/*.cc $SRC/
    cp /opt/oss-fuzz/projects/$PROJECT_NAME/build.sh $SRC/
    cp $SRC/secret_key_auth_fuzzer.cc $SRC/new_fuzzer.cc

    #patch -tuN $SRC/build.sh -i /challenge/.build.patch -r -
#----------------------------------------------------------------------
    build-cleanup
fi
build-srcfolders
mv /src-$LABEL /src

cd $SRC/$PROJECT_NAME
#----------------------------------------------------------------------
if [ ! -d "/home/hacker/fuzz-platform/$PROJECT_NAME" ]; then
   mkdir -p /home/hacker/fuzz-platform/$PROJECT_NAME
   cp $SRC/*.cc /home/hacker/fuzz-platform/$PROJECT_NAME
   cp $SRC/*.h /home/hacker/fuzz-platform/$PROJECT_NAME
   cp $SRC/build.sh /home/hacker/fuzz-platform/$PROJECT_NAME
else
   cp /home/hacker/fuzz-platform/$PROJECT_NAME/*.cc $SRC
   cp /home/hacker/fuzz-platform/$PROJECT_NAME/*.h $SRC
   cp /home/hacker/fuzz-platform/$PROJECT_NAME/build.sh $SRC
fi
#----------------------------------------------------------------------
if [ "$4" = "understanding" ]; then
    understanding $2 $3
elif [ "$4" = "planning" ]; then
    planning $2 $3
else
    fuzzlog
    compile
    drivers
fi
mv /src /src-$LABEL